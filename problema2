#formato: [nombre, categoria, precio base] 

menu = [
    ["Hamburguesa", "Comida rápida", 18000],
    ["Ensalada César", "Ensaladas", 12000],
    ["Pasta Carbonara", "Platos fuertes", 25000],
    ["Sándwich de pollo", "Comida rápida", 15000],
    ["Ceviche", "Mariscos", 32000],
    ["Arroz con pollo", "Platos fuertes", 20000],
    ["Jugo natural", "Bebidas", 5000]
]
# Definir parámetros de la promoción
categoria_objetivo = "Platos fuertes"
umbral_precio = 18000
descuento = 0.15  # 15%

#  Función para calcular el precio final
def calcular_precio_final(categoria, precio_base):
    """
    Calcula el precio final aplicando descuento si se cumplen las condiciones:
    - Pertenecer a la categoría objetivo
    - Precio base mayor al umbral establecido
    """
    if categoria == categoria_objetivo and precio_base > umbral_precio:
        precio_con_descuento = precio_base * (1 - descuento)
        return round(precio_con_descuento, 2)
    else:
        return precio_base
    print("=" * 60)
print("                MENÚ CON PROMOCIÓN")
print(f"Categoría con descuento: {categoria_objetivo}")
print(f"Umbral de precio: ${umbral_precio:,}")
print(f"Descuento: {int(descuento * 100)}%")
print("=" * 60)
print(f"{'Producto':<20} {'Precio Base':<15} {'Precio Final':<15} {'Estado'}")
print("-" * 60)
for producto in menu:
    nombre = producto[0]
    categoria = producto[1]
    precio_base = producto[2]
    precio_final = calcular_precio_final(categoria, precio_base)
    if precio_final < precio_base:
        estado = "Descuento aplicado"
    else:
        estado = "Sin descuento"
        
    print(f"{nombre:<20} ${precio_base:<14,} ${precio_final:<14,} {estado}")

print("=" * 60)
